# Copie este arquivo para .env.local e ajuste os valores

# Modo de operação: "mock" (padrão, sem blockchain) ou "blockchain" (requer Hardhat + MetaMask)
VITE_MODE=mock

# Endereço do contrato — preencha após executar "npm run deploy:local" na raiz do projeto
# Necessário apenas quando VITE_MODE=blockchain
VITE_CONTRACT_ADDRESS=
