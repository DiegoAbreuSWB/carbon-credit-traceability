# Normaliza line endings no repositório
* text=auto

# Força LF em arquivos de código
*.ts   text eol=lf
*.tsx  text eol=lf
*.sol  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.env* text eol=lf

# Binários — sem conversão
*.svg  binary
*.png  binary
*.jpg  binary
